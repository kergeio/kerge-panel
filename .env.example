# Settings for deploy/compose.yml and deploy/compose.external-proxy.yml.
# install.sh writes .env for you; this file lists every variable it may hold.
# Never put a password, key or token in .env.

# Domain of the panel, read by both Caddy and the panel.
KERGE_DOMAIN=panel.example.com

# Base URL used in the agent install command. Defaults to https://$KERGE_DOMAIN.
#KERGE_PUBLIC_URL=https://panel.example.com

# Listen address and data directory inside the panel container.
#KERGE_LISTEN=:3000
#KERGE_DATA_DIR=/data

# Proxies whose X-Forwarded-For the panel trusts, as IP addresses or CIDR
# ranges separated by commas. When unset, the compose file supplies the
# default: Caddy's fixed addresses with compose.yml, the Docker network
# gateway with compose.external-proxy.yml.
#KERGE_TRUSTED_PROXIES=172.30.0.2,fd6b:6572:6765::2

# The compose network and the fixed addresses of Caddy and the panel.
# Change them only if they clash with another network on this host.
#KERGE_NET_SUBNET=172.30.0.0/24
#KERGE_NET_CADDY_IP=172.30.0.2
#KERGE_NET_PANEL_IP=172.30.0.3
# IPv6 of the same network (compose.yml only).
#KERGE_NET_SUBNET6=fd6b:6572:6765::/64
#KERGE_NET_CADDY_IP6=fd6b:6572:6765::2
#KERGE_NET_PANEL_IP6=fd6b:6572:6765::3

# Deployment mode, recorded by install.sh. Re-running install.sh without
# --cloudflare / --no-cloudflare or --external-proxy / --no-external-proxy
# keeps these values.
KERGE_CLOUDFLARE=no
KERGE_EXTERNAL_PROXY=no

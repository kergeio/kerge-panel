# Caddy in front of the Kerge panel, for a domain proxied by Cloudflare with
# SSL/TLS encryption mode Full (strict).
#
# The panel runs from compose.external-proxy.yml and listens on
# 127.0.0.1:3000. If your Caddyfile already has a global options block,
# merge the servers settings into it.
#
# CF-Connecting-IP is believed only from Cloudflare's address ranges below.
# Cloudflare publishes them at https://www.cloudflare.com/ips-v4 and
# https://www.cloudflare.com/ips-v6; when they change, update this list.
# Requests that bypass Cloudflare count as coming from their own address.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

panel.example.com {
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}
